/* Autonomous tools: Auto panel, song Shorts cards, Clip Studio. Uses the editor's theme variables. */
.auto-cards{display:flex;flex-direction:column;gap:10px;margin:12px 0}
.auto-card,.clip-card{background:#191f1c;border:1px solid #303c32;border-radius:9px;padding:11px;display:flex;flex-direction:column;gap:8px}
.auto-card-top{display:flex;align-items:center;gap:9px;font-size:12px;cursor:pointer}
.auto-card-top input{accent-color:var(--accent)}
.auto-score{margin-left:auto;font:700 10px 'Space Grotesk',Arial,sans-serif;color:var(--accent);background:#1b2b1c;border-radius:5px;padding:3px 7px}
.auto-reasons{color:#8a9d8d;font-size:10px;line-height:1.5}
.auto-times{display:flex;align-items:center;gap:7px;color:#819784;font-size:10px}
.auto-times input{width:74px;padding:5px;background:#121713;color:#d4ecda;border:1px solid #344639;border-radius:4px;font:11px 'Space Grotesk',Arial,sans-serif}
.auto-card>input[type=text],.clip-field input,.clip-field textarea{width:100%;background:#111815;border:1px solid #38483b;color:#fff;border-radius:6px;padding:8px 9px;font-size:12px}
.clip-field{display:flex;flex-direction:column;gap:5px;font-size:10px;color:#819784;font-weight:700}
.clip-field textarea{resize:vertical}
.auto-results{display:flex;flex-direction:column;gap:12px;margin-top:14px}
.auto-result{background:#171d18;border:1px solid #313c34;border-radius:9px;padding:11px;display:flex;flex-direction:column;gap:8px}
.auto-result strong{font-size:11px;color:#d6e1d7}
.auto-result video{width:100%;max-height:300px;background:#000;border-radius:6px}
.auto-meta{display:flex;flex-direction:column;gap:3px}.auto-meta b{font-size:12px}.auto-meta small{color:#8a9d8d;font-size:10px;line-height:1.5;word-break:break-word}
.auto-actions{display:flex;flex-wrap:wrap;gap:6px}.auto-actions a.tiny-btn{text-decoration:none}

.clip-studio{position:fixed;inset:0;z-index:40;background:radial-gradient(ellipse at 70% 10%,#1d2c1f,#0c110e 60%);display:flex;flex-direction:column}
.clip-studio-bar{display:flex;align-items:center;justify-content:space-between;padding:20px 28px;border-bottom:1px solid var(--line)}
.clip-studio-bar h2{margin:8px 0 0;font:700 24px 'Space Grotesk',Arial,sans-serif;letter-spacing:-1px}
.clip-studio-body{flex:1;overflow-y:auto;padding:26px 28px 60px;scrollbar-width:thin;scrollbar-color:#3f5040 transparent}
.clip-step{max-width:1180px;margin:0 auto;display:flex;flex-direction:column;gap:16px}
#clipUploadStep{max-width:560px;padding-top:6vh}
#clipProgressStep{max-width:420px;align-items:center;text-align:center;padding-top:14vh}
#clipProgressStep small{color:#829586;font-size:11px}
#clipProgressStep .transcribe-meter{width:100%}
#clipMeter{height:100%;width:4%;background:var(--accent);transition:width .6s}
.clip-options{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.clip-options label,.clip-toolbar label{display:flex;flex-direction:column;gap:6px;font-size:11px;font-weight:700;color:#cdd9ce}
.clip-options select,.clip-toolbar select,.clip-toolbar input{background:#1a2020;color:#eaf1e9;border:1px solid #303b34;border-radius:7px;height:38px;padding:0 10px;font-size:12px}
.clip-toolbar input{width:72px}
.clip-check{grid-column:1/-1;flex-direction:row!important;align-items:flex-start;gap:9px!important;flex-wrap:wrap}
.clip-check input{accent-color:var(--accent);margin-top:3px}.clip-check small{flex-basis:100%;margin-left:26px;color:#7f8d80;font-weight:400}
.clip-fine{font-size:11px;color:#7f9183;line-height:1.6;margin:0}
.clip-toolbar{display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px}.clip-spacer{flex:1}
.clip-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.clip-card video{width:100%;aspect-ratio:16/9;background:#000;border-radius:6px}
.clip-studio .render-status{margin:0}
@media(max-width:760px){.clip-options{grid-template-columns:1fr}.clip-studio-bar,.clip-studio-body{padding-left:14px;padding-right:14px}}

/* Auto-edit card, brand kit, watch folder, translation, hook ideas */
.clip-studio-actions{display:flex;gap:10px}
.auto-edit-card{background:linear-gradient(135deg,#17241a,#131a16);border:1px solid #35523a;border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:14px}
.auto-edit-head{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.auto-edit-head div{display:flex;flex-direction:column;gap:5px;max-width:640px}.auto-edit-head strong{font:700 16px 'Space Grotesk',Arial,sans-serif}
.auto-edit-head small{color:#8fa593;font-size:11px;line-height:1.55}
.auto-edit-opts{display:flex;flex-wrap:wrap;gap:12px 22px;align-items:flex-end}
.auto-edit-opts label:not(.clip-check){display:flex;flex-direction:column;gap:5px;font-size:11px;font-weight:700;color:#cdd9ce}
.auto-edit-opts select{background:#1a2020;color:#eaf1e9;border:1px solid #303b34;border-radius:7px;height:34px;padding:0 9px;font-size:12px}
.auto-edit-opts .clip-check{font-size:12px;font-weight:500;align-items:center}
.ae-thumb{width:100%;max-width:520px;border-radius:7px;border:1px solid #303c32}
.ae-field{display:flex;flex-direction:column;gap:5px}.ae-field-head{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#cdd9ce}
.ae-field input,.ae-field textarea{width:100%;background:#111815;border:1px solid #38483b;color:#e9f1e8;border-radius:6px;padding:8px 9px;font-size:12px;resize:vertical}
.ae-shorts-title{font-size:12px;margin-top:6px;color:#cdd9ce}
.translate-box{display:flex;flex-direction:column;gap:9px;margin-top:6px;padding-top:10px;border-top:1px solid #2d382f}
.translate-box small{color:#8a9d8d;font-size:10px;line-height:1.5}
.lang-grid{display:flex;flex-wrap:wrap;gap:6px}
.lang-chip{display:flex;align-items:center;gap:5px;background:#1b221d;border:1px solid #303c32;border-radius:999px;padding:4px 10px;font-size:11px;cursor:pointer}
.lang-chip input{accent-color:var(--accent)}
.translate-file{display:flex;align-items:center;gap:8px;font-size:11px}.translate-file span{min-width:90px}
.idea-row{display:flex;flex-direction:column;gap:6px}.idea-chips{display:flex;flex-direction:column;gap:5px}
.idea-chip{text-align:left;background:#1b2b1c;border:1px solid #35523a;color:#d9f0d6;border-radius:7px;padding:6px 9px;font-size:11px;cursor:pointer}
.idea-chip:hover{border-color:var(--accent)}

.brand-modal{position:fixed;inset:0;z-index:60;background:rgba(5,9,6,.78);display:flex;align-items:center;justify-content:center;padding:18px}
.brand-card{background:#131a15;border:1px solid #35523a;border-radius:14px;padding:22px;max-width:640px;width:100%;max-height:92vh;overflow-y:auto;display:flex;flex-direction:column;gap:12px}
.brand-card h3{margin:0;font:700 20px 'Space Grotesk',Arial,sans-serif}
.brand-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.brand-grid label{display:flex;flex-direction:column;gap:5px;font-size:11px;font-weight:700;color:#cdd9ce}
.brand-grid label.clip-check{flex-direction:row;align-items:center}
.brand-grid input[type=text],.brand-grid input[type=number]{background:#111815;border:1px solid #38483b;color:#fff;border-radius:6px;padding:8px 9px;font-size:12px}
.brand-grid input[type=color]{width:100%;height:36px;border:1px solid #38483b;border-radius:6px;background:#111815;padding:2px}
.brand-wide{grid-column:1/-1}
.brand-logo{display:flex;align-items:center;gap:8px;flex-wrap:wrap;grid-column:1/-1}
.brand-logo img{height:48px;max-width:120px;object-fit:contain;background:#222;border-radius:6px;padding:4px}
.brand-actions{display:flex;justify-content:flex-end;gap:10px}

.watch-box{border:1px solid #303c32;border-radius:10px;padding:10px 14px;background:#141a16}
.watch-box summary{cursor:pointer;font-size:12px;font-weight:700;color:#cdd9ce}
.watch-box[open]{display:flex;flex-direction:column;gap:11px}
.watch-box label{display:flex;flex-direction:column;gap:5px;font-size:11px;font-weight:700;color:#cdd9ce}
.watch-box input[type=text],.watch-box select{background:#111815;border:1px solid #38483b;color:#fff;border-radius:6px;padding:8px 9px;font-size:12px}
.watch-actions{display:flex;gap:10px}
.watch-log{white-space:pre-wrap;font:11px/1.6 'Space Grotesk',Consolas,monospace;color:#9ab09d;max-height:150px;overflow-y:auto}
@media(max-width:760px){.brand-grid{grid-template-columns:1fr}}

.auto-edit-extras{display:flex;flex-wrap:wrap;gap:8px 20px;align-items:center;padding-top:12px;border-top:1px solid #2d4232}
.auto-edit-extras b{font-size:11px;color:#9fd69a;letter-spacing:.3px}.auto-edit-extras .clip-check{font-size:12px;font-weight:500;align-items:center}
.auto-edit-extras small{flex-basis:100%;color:#7f9183;font-size:10px;line-height:1.5}
.brand-sound{display:flex;flex-direction:column;gap:10px;padding-top:12px;border-top:1px solid #2d382f}
.brand-sound>b{font-size:12px}.brand-asset{display:flex;align-items:center;gap:10px;font-size:11px;font-weight:700;color:#cdd9ce}
.brand-asset>span:first-child{flex:1 1 150px}.brand-asset-name{color:#8fa593;font-weight:400;min-width:48px}

/* Presets, post tabs, proofreading, B-roll manager, Make overlay */
.preset-bar{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;padding-bottom:12px;border-bottom:1px solid #2d4232}
.preset-bar label{display:flex;flex-direction:column;gap:5px;font-size:11px;font-weight:700;color:#cdd9ce}
.preset-bar select,.preset-bar input{background:#1a2020;color:#eaf1e9;border:1px solid #303b34;border-radius:7px;height:34px;padding:0 9px;font-size:12px}
.make-tabs{display:flex;flex-wrap:wrap;gap:6px}
.make-tab{background:#1b221d;border:1px solid #303c32;color:#cdd9ce;border-radius:999px;padding:7px 14px;font-size:12px;cursor:pointer}
.make-tab:hover{border-color:var(--accent)}.make-tab.active{background:#1b2b1c;border-color:var(--accent);color:#e8ffe4}
.posts-box textarea{width:100%;background:#111815;border:1px solid #38483b;color:#e9f1e8;border-radius:6px;padding:8px 9px;font-size:12px;resize:vertical}
.proof-list{display:flex;flex-direction:column;gap:9px;max-height:42vh;overflow-y:auto}
.proof-row{display:flex;flex-direction:column;gap:4px}
.proof-row input,.proof-replace-row input{background:#111815;border:1px solid #38483b;color:#fff;border-radius:6px;padding:8px 9px;font-size:12px;width:100%}
.proof-replace{display:flex;flex-direction:column;gap:7px;font-size:11px;color:#cdd9ce;padding-top:10px;border-top:1px solid #2d382f}
.proof-replace-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.brand-broll{display:flex;flex-direction:column;gap:9px;padding-top:12px;border-top:1px solid #2d382f}
.brand-broll-head{display:flex;justify-content:space-between;align-items:center;font-size:12px}.brand-broll-head small{color:#8fa593}
.broll-list{display:flex;flex-direction:column;gap:7px}
.broll-row{display:grid;grid-template-columns:minmax(80px,1fr) 44px 2fr auto auto;gap:7px;align-items:center;font-size:11px}
.broll-row input,.broll-add input{background:#111815;border:1px solid #38483b;color:#fff;border-radius:6px;padding:7px 8px;font-size:11px;width:100%}
.broll-add{display:flex;gap:8px;align-items:center}
.make-step{max-width:760px}.make-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.make-field{display:flex;flex-direction:column;gap:6px;font-size:11px;font-weight:700;color:#cdd9ce}
.make-field.wide{grid-column:1/-1}.make-field.check{flex-direction:row;align-items:center;gap:9px;font-weight:500;font-size:12px}
.make-field input[type=text],.make-field input[type=number],.make-field textarea,.make-field select{background:#1a2020;color:#eaf1e9;border:1px solid #303b34;border-radius:7px;padding:9px 10px;font-size:12px;min-height:38px;width:100%}
.make-field input[type=file]{font-size:11px;color:#9fb2a2}.make-field small{font-weight:400;color:#7f9183}
.make-field.check input{accent-color:var(--accent)}
.make-go{grid-column:1/-1;justify-self:start}
@media(max-width:760px){.make-form{grid-template-columns:1fr}.broll-row{grid-template-columns:1fr 1fr}.proof-replace-row{grid-template-columns:1fr}}
.clip-toolbar .clip-check{flex-direction:row;align-items:center;gap:8px;font-weight:500}
.clip-toolbar input[type=checkbox]{width:auto;height:auto;accent-color:var(--accent)}
.make-warning{color:#ffd37a;font-size:12px;border-left:3px solid #ffb84d;padding:6px 10px;background:#2a2417;border-radius:4px}
.make-recent{display:flex;flex-direction:column;gap:8px;margin-top:18px;padding-top:14px;border-top:1px solid #2d382f;font-size:12px}
.recent-row{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;background:#161d18;border:1px solid #2b372e;border-radius:8px;padding:9px 12px}
.recent-row small{color:#8fa593}
.make-tab.unavailable{opacity:.45;text-decoration:line-through}

.make-groups{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.make-group{background:none;border:0;border-bottom:2px solid transparent;color:#9fb0a1;padding:4px 10px;font-size:12px;cursor:pointer}
.make-group:hover{color:#e8ffe4}.make-group.active{color:#e8ffe4;border-bottom-color:var(--accent)}
.make-tab.hidden{display:none}
.make-search{width:100%;max-width:320px;margin-bottom:8px;background:#141a15;border:1px solid #303c32;color:#e8ffe4;border-radius:8px;padding:7px 10px;font-size:13px}
.make-picked{color:#9fb0a1;word-break:break-all}
select.further{background:#1b221d;border:1px solid #303c32;color:#cdd9ce;border-radius:8px;padding:6px 8px;font-size:12px}
/* Sixty-odd tabs: show about four rows and scroll the rest, so the form is always on screen */
.make-tabs{max-height:164px;overflow-y:auto;padding-right:4px;scrollbar-width:thin}
.make-tabs:has(.make-tab.hidden){max-height:none}
.make-form input[type=file]::file-selector-button,.make input[type=file]::file-selector-button{background:#1b221d;color:#e8ffe4;border:1px solid #303c32;border-radius:8px;padding:6px 12px;margin-right:10px;cursor:pointer;font:inherit;font-size:12px}
.make-form input[type=file]::file-selector-button:hover,.make input[type=file]::file-selector-button:hover{border-color:var(--accent)}

/* ---- Make page polish: categories you can tell apart, a clear title for the chosen tool, drop-zone files ---- */
.g-create{--dot:#94ff73;--order:1}.g-video{--dot:#6ec8ff;--order:2}.g-audio{--dot:#ffb86b;--order:3}.g-picture{--dot:#d69bff;--order:4}.g-all{--dot:#cdd9ce}
.make-tab{order:var(--order);display:inline-flex;align-items:center;gap:7px;transition:border-color .15s,background .15s,transform .15s}
.make-tab::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--dot);flex:none;opacity:.85}
.make-tab:hover{transform:translateY(-1px)}
.make-tab.active{box-shadow:0 0 0 3px rgba(148,255,115,.14)}
.make-group::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--dot);margin-right:7px;vertical-align:1px}
.make-tool-title{margin:22px 0 4px;font-size:24px;letter-spacing:-.01em;display:flex;align-items:center;gap:12px;color:#f2f6f0}
.make-tool-title::after{content:attr(data-kind);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--dot);border:1px solid currentColor;border-radius:999px;padding:3px 9px;opacity:.9}
#makeBlurb{max-width:640px;line-height:1.55;font-size:13px;color:#a9b8ab;margin:0 0 14px}
.make-form{background:#0f1411;border:1px solid #232d26;border-radius:16px;padding:20px;box-shadow:0 12px 40px rgba(0,0,0,.28)}
.make-field.required>span:first-child::after{content:" *";color:var(--accent)}
.make-field.make-file{border:1.5px dashed #3b4a3e;border-radius:12px;padding:14px 16px;background:#0c110e;transition:border-color .15s,background .15s}
.make-field.make-file:hover,.dragging .make-field.make-file{border-color:var(--accent);background:#101a12}
.make-field input:focus-visible,.make-field select:focus-visible,.make-field textarea:focus-visible,.make-tab:focus-visible,.make-group:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.make-go{padding:11px 22px;font-size:14px;border-radius:10px;box-shadow:0 6px 18px rgba(148,255,115,.18)}
.make-go:disabled{box-shadow:none;opacity:.5;cursor:not-allowed}
.auto-result{border-radius:14px;padding:14px;background:#111714;border-color:#263029}
.dragging::after{content:"Drop it anywhere";position:fixed;inset:12px;border:2px dashed var(--accent);border-radius:18px;background:rgba(10,16,11,.72);display:grid;place-items:center;font-size:20px;font-weight:700;color:#e8ffe4;pointer-events:none;z-index:50}
@media (prefers-reduced-motion:reduce){.make-tab,.make-field.make-file{transition:none}.make-tab:hover{transform:none}}
.make-field.invalid{animation:make-nudge .35s}.make-field.invalid.make-file,.make-field.invalid input,.make-field.invalid select,.make-field.invalid textarea{border-color:#ff7a7a}
.make-field.invalid>span:first-child{color:#ffb0b0}
@keyframes make-nudge{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
@media (prefers-reduced-motion:reduce){.make-field.invalid{animation:none}}

.director-asset-library{max-height:520px;overflow:auto;overscroll-behavior:contain}
.director-asset-card,.director-finish-settings{padding:8px;border:1px solid #34483a;border-radius:7px;background:#111c16;margin:5px 0;min-width:0}
.director-asset-card summary,.director-finish-settings summary{cursor:pointer;overflow-wrap:anywhere;color:#c6dfc7;font-weight:600}
.director-asset-card[open]{display:grid;gap:7px}.director-asset-card input,.director-asset-card select{width:100%;min-width:0;margin:3px 0}.director-asset-pair{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:5px;align-items:center}
.director-edit-thumb{display:block;max-width:100%;max-height:220px;width:auto;height:auto;margin:6px auto;cursor:crosshair;border-radius:4px}
.director-finish-settings .control-group{margin-top:8px}.director-asset-pair button{white-space:normal}
