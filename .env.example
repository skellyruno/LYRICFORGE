# Set these in Railway service Variables, not in a committed .env file.
LYRICFORGE_REQUIRE_AUTH=1
LYRICFORGE_AUTH_USER=owner
LYRICFORGE_AUTH_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
LYRICFORGE_DATA=/data/workspace
HF_HOME=/data/model-cache
WHISPER_MODEL=small

# Optional: autonomous mode
# Lets the Clip Studio rerank clips with Claude (sends transcript text only). Leave unset to disable.
# ANTHROPIC_API_KEY=
# SKELLYMOTION_LLM_MODEL=claude-haiku-5-5
# Longest/biggest video the Clip Studio accepts.
# SKELLYMOTION_MAX_CLIP_SOURCE_MB=2048
# SKELLYMOTION_MAX_CLIP_SOURCE_MINUTES=180

# Optional local-only Director AI. Install a separate trusted Python environment with
# torch, transformers, diffusers, accelerate, Pillow and safetensors. No models included.
# SKELLYMOTION_AI_PYTHON=C:/path/to/venv/Scripts/python.exe
# SKELLYMOTION_IMAGE_MODEL=C:/models/local-stable-diffusion
# SKELLYMOTION_VISION_MODEL=C:/models/local-clip

# Optional local neural narration (install Piper and a licensed voice separately).
# LYRICFORGE_PIPER_EXE=C:\path\to\piper.exe
# LYRICFORGE_PIPER_MODEL=C:\voices\en_US-lessac-medium.onnx
